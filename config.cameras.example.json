{
  "device": "cpu",
  "loop_videos": false,
  "realtime_files": true,
  "show_window": true,
  "window_scale": 0.85,
  "ui_fps": 30,
  "display": {
    "width": 640,
    "height": 480
  },
  "sensors": {
    "ir": {
      "title": "SENSOR 01: ESP32-CAM IR (850nm illuminated)",
      "type": "opencv",
      "source": "",
      "backend": "V4L2",
      "camera": {
        "latest_only": true
      },
      "width": 640,
      "height": 480,
      "hfov_deg": 60,
      "offset": {
        "x": 0,
        "y": 0
      },
      "model_path": "models/ir_illuminated_best.onnx",
      "imgsz": 480,
      "confidence": 0.4,
      "group_eps": 55,
      "lens": "rectilinear",
      "_note": "OFF while source is empty. To enable: \"source\": \"http://<esp32-cam-ip>:81/stream\" (640x480 at 30 fps, set in the ESP32-CAM firmware, not here)."
    },
    "rgb": {
      "title": "SENSOR 02: ELP OV2710 180deg FISHEYE",
      "type": "opencv",
      "source": 0,
      "backend": "V4L2",
      "camera": {
        "fourcc": "MJPG",
        "width": 1280,
        "height": 720,
        "fps": 60,
        "latest_only": true
      },
      "width": 640,
      "height": 360,
      "hfov_deg": 90,
      "offset": {
        "x": 0,
        "y": 0
      },
      "model_path": "models/rgb_best.onnx",
      "imgsz": [
        384,
        640
      ],
      "confidence": 0.4,
      "group_eps": 250,
      "min_box_width": 12,
      "min_box_height": 12,
      "lens": "fisheye",
      "_note": "ELP-USBFHD01M-BL180: 180 deg lens, USB 2.0, MJPG needed for high resolutions. The centre crop keeps native pixel detail: half of the 180 deg width = 90 deg, so hfov_deg 90. If the image is a circle (black sides) set fov_across to height. Backend: V4L2 on Linux, DSHOW on Windows. Check the camera's real modes first.",
      "fov_across": "width",
      "crop": {
        "x": 0.25,
        "y": 0.25,
        "w": 0.5,
        "h": 0.5
      }
    }
  },
  "min_box_width": 12,
  "min_box_height": 12,
  "min_aspect_ratio": 0.25,
  "max_aspect_ratio": 4.0,
  "static_gate_enabled": true,
  "static_gate_frames": 15,
  "static_gate_px": 8.0,
  "max_coast_frames": 15,
  "kalman_accel_var": 4.0,
  "kalman_meas_sigma": 4.0,
  "gate_px": 80,
  "lead_frames": 0,
  "switch_margin": 0.25,
  "switch_hold_frames": 5,
  "priority_size_ref": 0.1,
  "priority_weights": {
    "size": 0.35,
    "center": 0.25,
    "conf": 0.25,
    "age": 0.15
  },
  "swarm_alert_size": 3,
  "panel_rows": 5,
  "onnx_threads": 2,
  "secondary_every_n": 3,
  "secondary_full_rate_when_unlocked": true,
  "send_hz": 30,
  "stale_result_ms": 500,
  "timing_csv": "timing_log.csv",
  "aim_sensor": "rgb",
  "invert_tilt": false,
  "require_arm": true,
  "auto_shoot_enabled": false,
  "auto_shoot_confidence": 0.65,
  "auto_shoot_min_age": 15,
  "auto_shoot_max_error_deg": 2.0,
  "fire_cooldown": 2.0,
  "esp32": {
    "enabled": true,
    "port": "/dev/ttyUSB0",
    "baud": 921600,
    "status_wait_s": 2.0,
    "status_timeout_s": 1.0
  },
  "auto_reload_enabled": false,
  "auto_reload_delay_s": 0.5,
  "reload_min_interval_s": 1.0,
  "reload_timeout_s": 6.0,
  "start_loaded": false,
  "ammo_source": "auto",
  "sensor_settle_s": 0.6,
  "reload_grace_s": 0.5
}